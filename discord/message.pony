        var pinned_at': (ISO8601 | None) = None
        var message': (Message | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "pinned_at" => pinned_at' = value as String
            | "message" => message' = Message.from_json(value as json.JsonObject)?
            end
        end

        pinned_at = pinned_at' as ISO8601
        message = message' as Message

    fun to_json(): json.JsonObject =>
        json.JsonObject
            .update("pinned_at", pinned_at)
            .update("message", message.to_json())

primitive _MessagePins
