            .update("burst", burst.i64())
            .update("normal", normal.i64())

class val MessageEmbed is Jsonable
    """
    https://docs.discord.com/developers/resources/message#embed-object-embed-structure

    To facilitate showing rich content, rich embeds do not follow the traditional limits of message content. However, some limits are still in place to prevent excessively large embeds: `title` 256 characters, `description` 4096 characters, up to 25 `fields`, `field.name` 256 characters, `field.value` 1024 characters, `footer.text` 2048 characters, `author.name` 256 characters. Additionally, the combined sum of characters in all `title`, `description`, `field.name`, `field.value`, `footer.text`, and `author.name` fields across all embeds attached to a message must not exceed 6000 characters.

    Embeds are deduplicated by URL. If a message contains multiple embeds with the same URL, only the first is shown.
    """

    let title: (String | None)
        """
        title of embed
        """

    let type': (MessageEmbedType | None)
        """
        type of embed (always "rich" for webhook embeds)
        """

    let description: (String | None)
        """
        description of embed
        """

    let url: (String | None)
        """
        url of embed
        """

    let timestamp: (ISO8601 | None)
        """
        timestamp of embed content
        """

    let color: (I64 | None)
        """
        color code of the embed
        """

    let footer: (MessageEmbedFooter | None)
        """
        footer information
        """

    let image: (MessageEmbedImage | None)
        """
        image information
        """

    let thumbnail: (MessageEmbedImage | None)
        """
        thumbnail information
        """

    let video: (MessageEmbedVideo | None)
        """
        video information
        """

    let provider: (MessageEmbedProvider | None)
        """
        provider information
        """

    let author: (MessageEmbedAuthor | None)
        """
        author information
        """

    let fields: (Array[MessageEmbedField] val | None)
        """
        fields information, max of 25
        """

    let flags: (Array[MessageEmbedFlag] val | None)
        """
        embed flags combined as a bitfield
        """

    new val create(
        title': (String | None) = None,
        type'': (MessageEmbedType | None) = None,
        description': (String | None) = None,
        url': (String | None) = None,
        timestamp': (ISO8601 | None) = None,
        color': (I64 | None) = None,
        footer': (MessageEmbedFooter | None) = None,
        image': (MessageEmbedImage | None) = None,
        thumbnail': (MessageEmbedImage | None) = None,
        video': (MessageEmbedVideo | None) = None,
        provider': (MessageEmbedProvider | None) = None,
        author': (MessageEmbedAuthor | None) = None,
        fields': (Array[MessageEmbedField] val | None) = None,
        flags': (Array[MessageEmbedFlag] val | None) = None
    ) =>
        title = title'
        type' = type''
        description = description'
        url = url'
        timestamp = timestamp'
        color = color'
        footer = footer'
        image = image'
        thumbnail = thumbnail'
        video = video'
        provider = provider'
        author = author'
        fields = fields'
        flags = flags'

    new val from_json(obj: json.JsonObject) ? =>
        var title': (String | None) = None
        var type'': (MessageEmbedType | None) = None
        var description': (String | None) = None
        var url': (String | None) = None
        var timestamp': (ISO8601 | None) = None
        var color': (I64 | None) = None
        var footer': (MessageEmbedFooter | None) = None
        var image': (MessageEmbedImage | None) = None
        var thumbnail': (MessageEmbedImage | None) = None
        var video': (MessageEmbedVideo | None) = None
        var provider': (MessageEmbedProvider | None) = None
        var author': (MessageEmbedAuthor | None) = None
        var fields': (Array[MessageEmbedField] val | None) = None
        var flags': (Array[MessageEmbedFlag] val | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "title" => title' = value as String
            | "type" => type'' = MessageEmbedTypes.from(value as String)?
            | "description" => description' = value as String
            | "url" => url' = value as String
            | "timestamp" => timestamp' = value as String
            | "color" => color' = value as I64
            | "footer" => footer' = MessageEmbedFooter.from_json(value as json.JsonObject)?
            | "image" => image' = MessageEmbedImage.from_json(value as json.JsonObject)?
            | "thumbnail" => thumbnail' = MessageEmbedImage.from_json(value as json.JsonObject)?
            | "video" => video' = MessageEmbedVideo.from_json(value as json.JsonObject)?
            | "provider" => provider' = MessageEmbedProvider.from_json(value as json.JsonObject)?
            | "author" => author' = MessageEmbedAuthor.from_json(value as json.JsonObject)?
            | "fields" => fields' = _MessageEmbedFields(value)?
            | "flags" => flags' = _MessageEmbedFlags((value as I64).u64())
            end
        end

        title = title'
        type' = type''
        description = description'
        url = url'
        timestamp = timestamp'
        color = color'
        footer = footer'
        image = image'
        thumbnail = thumbnail'
        video = video'
        provider = provider'
        author = author'
        fields = fields'
        flags = flags'

    fun to_json(): json.JsonObject =>
        var obj = json.JsonObject

        match title
        | let title': String => obj = obj.update("title", title')
        end

        match type'
        | let type''': MessageEmbedType => obj = obj.update("type", type'''.value())
        end

        match description
        | let description': String => obj = obj.update("description", description')
        end

        match url
        | let url': String => obj = obj.update("url", url')
        end

        match timestamp
        | let timestamp': ISO8601 => obj = obj.update("timestamp", timestamp')
        end

        match color
        | let color': I64 => obj = obj.update("color", color')
        end

        match footer
        | let footer': MessageEmbedFooter => obj = obj.update("footer", footer'.to_json())
        end

        match image
        | let image': MessageEmbedImage => obj = obj.update("image", image'.to_json())
        end

        match thumbnail
        | let thumbnail': MessageEmbedImage => obj = obj.update("thumbnail", thumbnail'.to_json())
        end

        match video
        | let video': MessageEmbedVideo => obj = obj.update("video", video'.to_json())
        end

        match provider
        | let provider': MessageEmbedProvider => obj = obj.update("provider", provider'.to_json())
        end

        match author
        | let author': MessageEmbedAuthor => obj = obj.update("author", author'.to_json())
        end

        match fields
        | let fields': Array[MessageEmbedField] val => obj = obj.update("fields", _MessageEmbedFields.to_json(fields'))
        end

        match flags
        | let flags': Array[MessageEmbedFlag] val => obj = obj.update("flags", _MessageEmbedFlags.to_json(flags'))
        end

        obj

primitive _MessageEmbeds
    fun apply(value: json.JsonValue): Array[MessageEmbed] val ? =>
        """
        Decodes an array of embeds.
        """

        let array = value as json.JsonArray
        recover val
            let embeds = Array[MessageEmbed](array.size())
            for entry in array.values() do embeds.push(MessageEmbed.from_json(entry as json.JsonObject)?) end
            embeds
        end

    fun to_json(embeds: Array[MessageEmbed] val): json.JsonArray =>
        var array = json.JsonArray
        for entry in embeds.values() do array = array.push(entry.to_json()) end
        array

trait val MessageEmbedType is (collections.Hashable & Equatable[MessageEmbedType])
    """
    https://docs.discord.com/developers/resources/message#embed-object-embed-types

    Embed types are "loose" types that should be considered deprecated and might be removed in a future API version.
    """

    fun value(): String

    fun hash(): USize => value().hash()

    fun eq(that: MessageEmbedType): Bool => value() == that.value()
primitive RichMessageEmbedType is MessageEmbedType
    """
    generic embed rendered from embed attributes
    """

    fun value(): String => "rich"
primitive ImageMessageEmbedType is MessageEmbedType
    """
    image embed
    """

    fun value(): String => "image"
primitive VideoMessageEmbedType is MessageEmbedType
    """
    video embed
    """

    fun value(): String => "video"
primitive GifvMessageEmbedType is MessageEmbedType
    """
    animated gif image embed rendered as a video embed
    """

    fun value(): String => "gifv"
primitive ArticleMessageEmbedType is MessageEmbedType
    """
    article embed
    """

    fun value(): String => "article"
primitive LinkMessageEmbedType is MessageEmbedType
    """
    link embed
    """

    fun value(): String => "link"
primitive PollResultMessageEmbedType is MessageEmbedType
    """
    poll result embed

    Poll result embeds carry their additional data as fields: `poll_question_text`, `victor_answer_votes`, `total_votes`, `victor_answer_id`, `victor_answer_text`, `victor_answer_emoji_id`, `victor_answer_emoji_name` and `victor_answer_emoji_animated`.
    """

    fun value(): String => "poll_result"
primitive MessageEmbedTypes
    fun from(value: String): MessageEmbedType ? =>
        match value
        | "rich" => RichMessageEmbedType
        | "image" => ImageMessageEmbedType
        | "video" => VideoMessageEmbedType
        | "gifv" => GifvMessageEmbedType
        | "article" => ArticleMessageEmbedType
        | "link" => LinkMessageEmbedType
        | "poll_result" => PollResultMessageEmbedType
        else error
        end

trait val MessageEmbedFlag is (collections.Hashable & Equatable[MessageEmbedFlag])
    """
    https://docs.discord.com/developers/resources/message#embed-object-embed-flags
    """

    fun value(): U8

    fun hash(): USize => value().hash()

    fun eq(that: MessageEmbedFlag): Bool => value() == that.value()
primitive IsContentInventoryEntryMessageEmbedFlag is MessageEmbedFlag
    """
    this embed is a fallback for a reply to an activity card
    """

    fun value(): U8 => 5
primitive MessageEmbedFlags
    fun from(value: U8): MessageEmbedFlag ? =>
        match value
        | 5 => IsContentInventoryEntryMessageEmbedFlag
        else error
        end

primitive _MessageEmbedFlags
    fun apply(bits: U64): Array[MessageEmbedFlag] val =>
        recover val
            let flags = Array[MessageEmbedFlag]
            var shift: U8 = 0
            while shift < 64 do
                if (bits and (U64(1) << shift.u64())) != 0 then
                    try flags.push(MessageEmbedFlags.from(shift)?) end
                end
                shift = shift + 1
            end
            flags
        end

    fun to_json(flags: Array[MessageEmbedFlag] val): I64 =>
        var bits: U64 = 0
        for flag in flags.values() do bits = bits or (U64(1) << flag.value().u64()) end
        bits.i64()

