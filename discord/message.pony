use collections = "collections"
use json = "json"

class val Message is Jsonable
    """
    https://docs.discord.com/developers/resources/message#message-object

    Represents a message sent in a channel within Discord.

    An app will receive empty values in the `content`, `embeds`, `attachments`, and `components` fields while `poll` will be omitted if they have not configured (or been approved for) the `MESSAGE_CONTENT` privileged intent (`1 << 15`).
    """

    let id: Snowflake
        """
        id of the message
        """

    let channel_id: Snowflake
        """
        id of the channel the message was sent in
        """

    let author: User
        """
        the author of this message (not guaranteed to be a valid user)

        The author object follows the structure of the user object, but is only a valid user in the case where the message is generated by a user or bot user. If the message is generated by a webhook, the author object corresponds to the webhook's id, username, and avatar. You can tell if a message is generated by a webhook by checking for the `webhook_id` on the message object.
        """

    let content: String
        """
        contents of the message
        """

    let timestamp: ISO8601
        """
        when this message was sent
        """

    let edited_timestamp: (ISO8601 | None)
        """
        when this message was edited (or null if never)
        """

    let tts: Bool
        """
        whether this was a TTS message
        """

    let mention_everyone: Bool
        """
        whether this message mentions everyone
        """

    let mentions: Array[User] val
        """
        users specifically mentioned in the message
        """

    let mention_roles: Array[Snowflake] val
        """
        roles specifically mentioned in this message
        """

    let mention_channels: (Array[ChannelMention] val | None)
        """
        channels specifically mentioned in this message

        Not all channel mentions in a message will appear in `mention_channels`. Only textual channels that are visible to everyone in a public guild will ever be included. Only crossposted messages (via Channel Following) currently include `mention_channels` at all. If no mentions in the message meet these requirements, this field will not be sent.
        """

    let attachments: Array[MessageAttachment] val
        """
        any attached files that are not referenced in embeds or components
        """

    let embeds: Array[MessageEmbed] val
        """
        any embedded content
        """

    let reactions: (Array[MessageReaction] val | None)
        """
        reactions to the message
        """

    let nonce: (USize | String | None)
        """
        used for validating a message was sent
        """

    let pinned: Bool
        """
        whether this message is pinned
        """

    let webhook_id: (Snowflake | None)
        """
        if the message is generated by a webhook, this is the webhook's id
        """

    let type': MessageType
        """
        type of message
        """

    let activity: (MessageActivity | None)
        """
        sent with Rich Presence-related chat embeds
        """

    let application: (PartialApplication | None)
        """
        sent with Rich Presence-related chat embeds

        This is a partial application object: Discord sends only `id`, `name`, `icon`, `description` and `cover_image`.
        """

    let application_id: (Snowflake | None)
        """
        if the message is an Interaction or application-owned webhook, this is the id of the application
        """

    let flags: (Array[MessageFlag] val | None)
        """
        message flags combined as a bitfield
        """

    let message_reference: (MessageReference | None)
        """
        data showing the source of a crosspost, channel follow add, pin, or reply message
        """

    let message_snapshots: (Array[MessageSnapshot] val | None)
        """
        the message associated with the `message_reference`. This is a minimal subset of fields in a message (e.g. `author` is excluded.)
        """

    let referenced_message: (Message | None)
        """
        the message associated with the `message_reference`

        This field is only returned for messages with a `type` of `19` (REPLY), `21` (THREAD_STARTER_MESSAGE), or `23` (CONTEXT_MENU_COMMAND). If the message is one of these but the `referenced_message` field is not present, the backend did not attempt to fetch the message that was being replied to, so its state is unknown. If the field exists but is null, the referenced message was deleted.
        """

    let interaction_metadata: (MessageInteractionMetadata | None)
        """
        Sent if the message is sent as a result of an interaction
        """

    let interaction: (MessageInteraction | None)
        """
        Deprecated in favor of `interaction_metadata`; sent if the message is a response to an interaction
        """

    let thread: (Channel | None)
        """
        the thread that was started from this message, includes thread member object
        """

    let components: (Array[Component] val | None)
        """
        sent if the message contains components like buttons, action rows, or other interactive components
        """

    let sticker_items: (Array[StickerItem] val | None)
        """
        sent if the message contains stickers
        """

    let stickers: (Array[Sticker] val | None)
        """
        Deprecated. The stickers sent with the message
        """

    let position: (USize | None)
        """
        A generally increasing integer (there may be gaps or duplicates) that represents the approximate position of the message in a thread, it can be used to estimate the relative position of the message in a thread in company with `total_message_sent` on parent thread
        """

    let role_subscription_data: (RoleSubscriptionData | None)
        """
        data of the role subscription purchase or renewal that prompted this ROLE_SUBSCRIPTION_PURCHASE message
        """

    let resolved: (ResolvedData | None)
        """
        data for users, members, channels, and roles referenced in this message
        """

    let poll: (Poll | None)
        """
        A poll!
        """

    let call: (MessageCall | None)
        """
        the call associated with the message
        """

    let shared_client_theme: (SharedClientTheme | None)
        """
        the custom client-side theme shared via the message
        """

    new val create(
        id': Snowflake,
        channel_id': Snowflake,
        author': User,
        content': String,
        timestamp': ISO8601,
        edited_timestamp': (ISO8601 | None) = None,
        tts': Bool,
        mention_everyone': Bool,
        mentions': Array[User] val,
        mention_roles': Array[Snowflake] val,
        mention_channels': (Array[ChannelMention] val | None) = None,
        attachments': Array[MessageAttachment] val,
        embeds': Array[MessageEmbed] val,
        reactions': (Array[MessageReaction] val | None) = None,
        nonce': (USize | String | None) = None,
        pinned': Bool,
        webhook_id': (Snowflake | None) = None,
        type'': MessageType,
        activity': (MessageActivity | None) = None,
        application': (PartialApplication | None) = None,
        application_id': (Snowflake | None) = None,
        flags': (Array[MessageFlag] val | None) = None,
        message_reference': (MessageReference | None) = None,
        message_snapshots': (Array[MessageSnapshot] val | None) = None,
        referenced_message': (Message | None) = None,
        interaction_metadata': (MessageInteractionMetadata | None) = None,
        interaction': (MessageInteraction | None) = None,
        thread': (Channel | None) = None,
        components': (Array[Component] val | None) = None,
        sticker_items': (Array[StickerItem] val | None) = None,
        stickers': (Array[Sticker] val | None) = None,
        position': (USize | None) = None,
        role_subscription_data': (RoleSubscriptionData | None) = None,
        resolved': (ResolvedData | None) = None,
        poll': (Poll | None) = None,
        call': (MessageCall | None) = None,
        shared_client_theme': (SharedClientTheme | None) = None
    ) =>
        id = id'
        channel_id = channel_id'
        author = author'
        content = content'
        timestamp = timestamp'
        edited_timestamp = edited_timestamp'
        tts = tts'
        mention_everyone = mention_everyone'
        mentions = mentions'
        mention_roles = mention_roles'
        mention_channels = mention_channels'
        attachments = attachments'
        embeds = embeds'
        reactions = reactions'
        nonce = nonce'
        pinned = pinned'
        webhook_id = webhook_id'
        type' = type''
        activity = activity'
        application = application'
        application_id = application_id'
        flags = flags'
        message_reference = message_reference'
        message_snapshots = message_snapshots'
        referenced_message = referenced_message'
        interaction_metadata = interaction_metadata'
        interaction = interaction'
        thread = thread'
        components = components'
        sticker_items = sticker_items'
        stickers = stickers'
        position = position'
        role_subscription_data = role_subscription_data'
        resolved = resolved'
        poll = poll'
        call = call'
        shared_client_theme = shared_client_theme'

    new val from_json(obj: json.JsonObject) ? =>
        var id': (Snowflake | None) = None
        var channel_id': (Snowflake | None) = None
        var author': (User | None) = None
        var content': (String | None) = None
        var timestamp': (ISO8601 | None) = None
        var edited_timestamp': (ISO8601 | None) = None
        var tts': (Bool | None) = None
        var mention_everyone': (Bool | None) = None
        var mentions': (Array[User] val | None) = None
        var mention_roles': (Array[Snowflake] val | None) = None
        var mention_channels': (Array[ChannelMention] val | None) = None
        var attachments': (Array[MessageAttachment] val | None) = None
        var embeds': (Array[MessageEmbed] val | None) = None
        var reactions': (Array[MessageReaction] val | None) = None
        var nonce': (USize | String | None) = None
        var pinned': (Bool | None) = None
        var webhook_id': (Snowflake | None) = None
        var type'': (MessageType | None) = None
        var activity': (MessageActivity | None) = None
        var application': (PartialApplication | None) = None
        var application_id': (Snowflake | None) = None
        var flags': (Array[MessageFlag] val | None) = None
        var message_reference': (MessageReference | None) = None
        var message_snapshots': (Array[MessageSnapshot] val | None) = None
        var referenced_message': (Message | None) = None
        var interaction_metadata': (MessageInteractionMetadata | None) = None
        var interaction': (MessageInteraction | None) = None
        var thread': (Channel | None) = None
        var components': (Array[Component] val | None) = None
        var sticker_items': (Array[StickerItem] val | None) = None
        var stickers': (Array[Sticker] val | None) = None
        var position': (USize | None) = None
        var role_subscription_data': (RoleSubscriptionData | None) = None
        var resolved': (ResolvedData | None) = None
        var poll': (Poll | None) = None
        var call': (MessageCall | None) = None
        var shared_client_theme': (SharedClientTheme | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "id" => id' = Snowflake.from_json(value)?
            | "channel_id" => channel_id' = Snowflake.from_json(value)?
            | "author" => author' = User.from_json(value as json.JsonObject)?
            | "content" => content' = value as String
            | "timestamp" => timestamp' = value as String
            | "edited_timestamp" =>
                match value | let string: String => edited_timestamp' = string end
            | "tts" => tts' = value as Bool
            | "mention_everyone" => mention_everyone' = value as Bool
            | "mentions" => mentions' = _Users(value)?
            | "mention_roles" => mention_roles' = _Snowflakes(value)?
            | "mention_channels" => mention_channels' = _ChannelMentions(value)?
            | "attachments" => attachments' = _MessageAttachments(value)?
            | "embeds" => embeds' = _MessageEmbeds(value)?
            | "reactions" => reactions' = _MessageReactions(value)?
            | "nonce" =>
                match value
                | let integer: I64 => nonce' = integer.usize()
                | let string: String => nonce' = string
                end
            | "pinned" => pinned' = value as Bool
            | "webhook_id" => webhook_id' = Snowflake.from_json(value)?
            | "type" => type'' = MessageTypes.from((value as I64).u8())?
            | "activity" => activity' = MessageActivity.from_json(value as json.JsonObject)?
            | "application" => application' = PartialApplication.from_json(value as json.JsonObject)?
            | "application_id" => application_id' = Snowflake.from_json(value)?
            | "flags" => flags' = _MessageFlags((value as I64).u64())
            | "message_reference" => message_reference' = MessageReference.from_json(value as json.JsonObject)?
            | "message_snapshots" => message_snapshots' = _MessageSnapshots(value)?
            | "referenced_message" =>
                match value | let obj': json.JsonObject => referenced_message' = Message.from_json(obj')? end
            | "interaction_metadata" => interaction_metadata' = MessageInteractionMetadatas.from_json(value as json.JsonObject)?
            | "interaction" => interaction' = MessageInteraction.from_json(value as json.JsonObject)?
            | "thread" => thread' = Channel.from_json(value as json.JsonObject)?
            | "components" => components' = _Components(value)?
            | "sticker_items" => sticker_items' = _StickerItems(value)?
            | "stickers" => stickers' = _Stickers(value)?
            | "position" => position' = (value as I64).usize()
            | "role_subscription_data" => role_subscription_data' = RoleSubscriptionData.from_json(value as json.JsonObject)?
            | "resolved" => resolved' = ResolvedData.from_json(value as json.JsonObject)?
            | "poll" => poll' = Poll.from_json(value as json.JsonObject)?
            | "call" => call' = MessageCall.from_json(value as json.JsonObject)?
            | "shared_client_theme" => shared_client_theme' = SharedClientTheme.from_json(value as json.JsonObject)?
            end
        end

        id = id' as Snowflake
        channel_id = channel_id' as Snowflake
        author = author' as User
        content = content' as String
        timestamp = timestamp' as ISO8601
        edited_timestamp = edited_timestamp'
        tts = tts' as Bool
        mention_everyone = mention_everyone' as Bool
        mentions = mentions' as Array[User] val
        mention_roles = mention_roles' as Array[Snowflake] val
        mention_channels = mention_channels'
        attachments = attachments' as Array[MessageAttachment] val
        embeds = embeds' as Array[MessageEmbed] val
        reactions = reactions'
        nonce = nonce'
        pinned = pinned' as Bool
        webhook_id = webhook_id'
        type' = type'' as MessageType
        activity = activity'
        application = application'
        application_id = application_id'
        flags = flags'
        message_reference = message_reference'
        message_snapshots = message_snapshots'
        referenced_message = referenced_message'
        interaction_metadata = interaction_metadata'
        interaction = interaction'
        thread = thread'
        components = components'
        sticker_items = sticker_items'
        stickers = stickers'
        position = position'
        role_subscription_data = role_subscription_data'
        resolved = resolved'
        poll = poll'
        call = call'
        shared_client_theme = shared_client_theme'

    fun to_json(): json.JsonObject =>
        var obj = json.JsonObject
            .update("id", id.to_json())
            .update("channel_id", channel_id.to_json())
            .update("author", author.to_json())
            .update("content", content)
            .update("timestamp", timestamp)
            .update("edited_timestamp", edited_timestamp)
            .update("tts", tts)
            .update("mention_everyone", mention_everyone)
            .update("mentions", _Users.to_json(mentions))
            .update("mention_roles", _Snowflakes.to_json(mention_roles))
            .update("attachments", _MessageAttachments.to_json(attachments))
            .update("embeds", _MessageEmbeds.to_json(embeds))
            .update("pinned", pinned)
            .update("type", type'.value().i64())

        match mention_channels
        | let mention_channels': Array[ChannelMention] val => obj = obj.update("mention_channels", _ChannelMentions.to_json(mention_channels'))
        end

        match reactions
        | let reactions': Array[MessageReaction] val => obj = obj.update("reactions", _MessageReactions.to_json(reactions'))
        end

        match nonce
        | let nonce': USize => obj = obj.update("nonce", nonce'.i64())
        | let nonce': String => obj = obj.update("nonce", nonce')
        end

        match webhook_id
        | let webhook_id': Snowflake => obj = obj.update("webhook_id", webhook_id'.to_json())
        end

        match activity
        | let activity': MessageActivity => obj = obj.update("activity", activity'.to_json())
        end

        match application
        | let application': PartialApplication => obj = obj.update("application", application'.to_json())
        end

        match application_id
        | let application_id': Snowflake => obj = obj.update("application_id", application_id'.to_json())
        end

        match flags
        | let flags': Array[MessageFlag] val => obj = obj.update("flags", _MessageFlags.to_json(flags'))
        end

        match message_reference
        | let message_reference': MessageReference => obj = obj.update("message_reference", message_reference'.to_json())
        end

        match message_snapshots
        | let message_snapshots': Array[MessageSnapshot] val => obj = obj.update("message_snapshots", _MessageSnapshots.to_json(message_snapshots'))
        end

        match referenced_message
        | let referenced_message': Message => obj = obj.update("referenced_message", referenced_message'.to_json())
        end

        match interaction_metadata
        | let interaction_metadata': MessageInteractionMetadata => obj = obj.update("interaction_metadata", interaction_metadata'.to_json())
        end

        match interaction
        | let interaction': MessageInteraction => obj = obj.update("interaction", interaction'.to_json())
        end

        match thread
        | let thread': Channel => obj = obj.update("thread", thread'.to_json())
        end

        match components
        | let components': Array[Component] val => obj = obj.update("components", _Components.to_json(components'))
        end

        match sticker_items
        | let sticker_items': Array[StickerItem] val => obj = obj.update("sticker_items", _StickerItems.to_json(sticker_items'))
        end

        match stickers
        | let stickers': Array[Sticker] val => obj = obj.update("stickers", _Stickers.to_json(stickers'))
        end

        match position
        | let position': USize => obj = obj.update("position", position'.i64())
        end

        match role_subscription_data
        | let role_subscription_data': RoleSubscriptionData => obj = obj.update("role_subscription_data", role_subscription_data'.to_json())
        end

        match resolved
        | let resolved': ResolvedData => obj = obj.update("resolved", resolved'.to_json())
        end

        match poll
        | let poll': Poll => obj = obj.update("poll", poll'.to_json())
        end

        match call
        | let call': MessageCall => obj = obj.update("call", call'.to_json())
        end

        match shared_client_theme
        | let shared_client_theme': SharedClientTheme => obj = obj.update("shared_client_theme", shared_client_theme'.to_json())
        end

        obj

primitive _Messages
    fun apply(value: json.JsonValue): Array[Message] val ? =>
        """
        Decodes an array of messages.
        """

        let array = value as json.JsonArray
        recover val
            let messages = Array[Message](array.size())
            for message in array.values() do messages.push(Message.from_json(message as json.JsonObject)?) end
            messages
        end

    fun to_json(messages: Array[Message] val): json.JsonArray =>
        var array = json.JsonArray
        for message in messages.values() do array = array.push(message.to_json()) end
        array

trait val MessageType is (collections.Hashable & Equatable[MessageType])
    """
    https://docs.discord.com/developers/resources/message#message-object-message-types

    Type `19` and `20` are only available in API v8 and above. In v6, they are represented as type `0`. Additionally, type `21` is only available in API v9 and above.
    """

    fun value(): U8

    fun deletable(): Bool

    fun hash(): USize => value().hash()

    fun eq(that: MessageType): Bool => value() == that.value()
primitive DefaultMessageType is MessageType
    fun value(): U8 => 0

    fun deletable(): Bool => true
primitive RecipientAddMessageType is MessageType
    fun value(): U8 => 1

    fun deletable(): Bool => false
primitive RecipientRemoveMessageType is MessageType
    fun value(): U8 => 2

    fun deletable(): Bool => false
primitive CallMessageType is MessageType
    fun value(): U8 => 3

    fun deletable(): Bool => false
primitive ChannelNameChangeMessageType is MessageType
    fun value(): U8 => 4

    fun deletable(): Bool => false
primitive ChannelIconChangeMessageType is MessageType
    fun value(): U8 => 5

    fun deletable(): Bool => false
primitive ChannelPinnedMessageMessageType is MessageType
    fun value(): U8 => 6

    fun deletable(): Bool => true
primitive UserJoinMessageType is MessageType
    fun value(): U8 => 7

    fun deletable(): Bool => true
primitive GuildBoostMessageType is MessageType
    fun value(): U8 => 8

    fun deletable(): Bool => true
primitive GuildBoostTier1MessageType is MessageType
    fun value(): U8 => 9

    fun deletable(): Bool => true
primitive GuildBoostTier2MessageType is MessageType
    fun value(): U8 => 10

    fun deletable(): Bool => true
primitive GuildBoostTier3MessageType is MessageType
    fun value(): U8 => 11

    fun deletable(): Bool => true
primitive ChannelFollowAddMessageType is MessageType
    fun value(): U8 => 12

    fun deletable(): Bool => true
primitive GuildDiscoveryDisqualifiedMessageType is MessageType
    fun value(): U8 => 14

    fun deletable(): Bool => true
primitive GuildDiscoveryRequalifiedMessageType is MessageType
    fun value(): U8 => 15

    fun deletable(): Bool => true
primitive GuildDiscoveryGracePeriodInitialWarningMessageType is MessageType
    fun value(): U8 => 16

    fun deletable(): Bool => true
primitive GuildDiscoveryGracePeriodFinalWarningMessageType is MessageType
    fun value(): U8 => 17

    fun deletable(): Bool => true
primitive ThreadCreatedMessageType is MessageType
    fun value(): U8 => 18

    fun deletable(): Bool => true
primitive ReplyMessageType is MessageType
    fun value(): U8 => 19

    fun deletable(): Bool => true
primitive ChatInputCommandMessageType is MessageType
    fun value(): U8 => 20

    fun deletable(): Bool => true
primitive ThreadStarterMessageType is MessageType
    fun value(): U8 => 21

    fun deletable(): Bool => false
primitive GuildInviteReminderMessageType is MessageType
    fun value(): U8 => 22

    fun deletable(): Bool => true
primitive ContextMenuCommandMessageType is MessageType
    fun value(): U8 => 23

    fun deletable(): Bool => true
primitive AutoModerationActionMessageType is MessageType
    """
    Can only be deleted by members with the MANAGE_MESSAGES permission
    """

    fun value(): U8 => 24

    fun deletable(): Bool => true
primitive RoleSubscriptionPurchaseMessageType is MessageType
    fun value(): U8 => 25

    fun deletable(): Bool => true
primitive InteractionPremiumUpsellMessageType is MessageType
    fun value(): U8 => 26

    fun deletable(): Bool => true
primitive StageStartMessageType is MessageType
    fun value(): U8 => 27

    fun deletable(): Bool => true
primitive StageEndMessageType is MessageType
    fun value(): U8 => 28

    fun deletable(): Bool => true
primitive StageSpeakerMessageType is MessageType
    fun value(): U8 => 29

    fun deletable(): Bool => true
primitive StageTopicMessageType is MessageType
    fun value(): U8 => 31

    fun deletable(): Bool => true
primitive GuildApplicationPremiumSubscriptionMessageType is MessageType
    fun value(): U8 => 32

    fun deletable(): Bool => true
primitive GuildIncidentAlertModeEnabledMessageType is MessageType
    fun value(): U8 => 36

    fun deletable(): Bool => true
primitive GuildIncidentAlertModeDisabledMessageType is MessageType
    fun value(): U8 => 37

    fun deletable(): Bool => true
primitive GuildIncidentReportRaidMessageType is MessageType
    fun value(): U8 => 38

    fun deletable(): Bool => true
primitive GuildIncidentReportFalseAlarmMessageType is MessageType
    fun value(): U8 => 39

    fun deletable(): Bool => true
primitive PurchaseNotificationMessageType is MessageType
    fun value(): U8 => 44

    fun deletable(): Bool => true
primitive PollResultMessageType is MessageType
    fun value(): U8 => 46

    fun deletable(): Bool => true
primitive MessageTypes
    fun from(value: U8): MessageType ? =>
        match value
        | 0 => DefaultMessageType
        | 1 => RecipientAddMessageType
        | 2 => RecipientRemoveMessageType
        | 3 => CallMessageType
        | 4 => ChannelNameChangeMessageType
        | 5 => ChannelIconChangeMessageType
        | 6 => ChannelPinnedMessageMessageType
        | 7 => UserJoinMessageType
        | 8 => GuildBoostMessageType
        | 9 => GuildBoostTier1MessageType
        | 10 => GuildBoostTier2MessageType
        | 11 => GuildBoostTier3MessageType
        | 12 => ChannelFollowAddMessageType
        | 14 => GuildDiscoveryDisqualifiedMessageType
        | 15 => GuildDiscoveryRequalifiedMessageType
        | 16 => GuildDiscoveryGracePeriodInitialWarningMessageType
        | 17 => GuildDiscoveryGracePeriodFinalWarningMessageType
        | 18 => ThreadCreatedMessageType
        | 19 => ReplyMessageType
        | 20 => ChatInputCommandMessageType
        | 21 => ThreadStarterMessageType
        | 22 => GuildInviteReminderMessageType
        | 23 => ContextMenuCommandMessageType
        | 24 => AutoModerationActionMessageType
        | 25 => RoleSubscriptionPurchaseMessageType
        | 26 => InteractionPremiumUpsellMessageType
        | 27 => StageStartMessageType
        | 28 => StageEndMessageType
        | 29 => StageSpeakerMessageType
        | 31 => StageTopicMessageType
        | 32 => GuildApplicationPremiumSubscriptionMessageType
        | 36 => GuildIncidentAlertModeEnabledMessageType
        | 37 => GuildIncidentAlertModeDisabledMessageType
        | 38 => GuildIncidentReportRaidMessageType
        | 39 => GuildIncidentReportFalseAlarmMessageType
        | 44 => PurchaseNotificationMessageType
        | 46 => PollResultMessageType
        else error
        end

class val MessageActivity is Jsonable
    """
    https://docs.discord.com/developers/resources/message#message-object-message-activity-structure
    """

    let type': MessageActivityType
        """
        type of message activity
        """

    let party_id: (String | None)
        """
        `party_id` from a Rich Presence event
        """

    new val create(type'': MessageActivityType, party_id': (String | None) = None) =>
        type' = type''
        party_id = party_id'

    new val from_json(obj: json.JsonObject) ? =>
        var type'': (MessageActivityType | None) = None
        var party_id': (String | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "type" => type'' = MessageActivityTypes.from((value as I64).u8())?
            | "party_id" => party_id' = value as String
            end
        end

        type' = type'' as MessageActivityType
        party_id = party_id'

    fun to_json(): json.JsonObject =>
        var obj = json.JsonObject
            .update("type", type'.value().i64())

        match party_id
        | let party_id': String => obj = obj.update("party_id", party_id')
        end

        obj

trait val MessageActivityType is (collections.Hashable & Equatable[MessageActivityType])
    """
    https://docs.discord.com/developers/resources/message#message-object-message-activity-types
    """

    fun value(): U8

    fun hash(): USize => value().hash()

    fun eq(that: MessageActivityType): Bool => value() == that.value()
primitive JoinMessageActivityType is MessageActivityType
    fun value(): U8 => 1
primitive SpectateMessageActivityType is MessageActivityType
    fun value(): U8 => 2
primitive ListenMessageActivityType is MessageActivityType
    fun value(): U8 => 3
primitive JoinRequestMessageActivityType is MessageActivityType
    fun value(): U8 => 5
primitive MessageActivityTypes
    fun from(value: U8): MessageActivityType ? =>
        match value
        | 1 => JoinMessageActivityType
        | 2 => SpectateMessageActivityType
        | 3 => ListenMessageActivityType
        | 5 => JoinRequestMessageActivityType
        else error
        end

trait val MessageFlag is (collections.Hashable & Equatable[MessageFlag])
    """
    https://docs.discord.com/developers/resources/message#message-object-message-flags
    """

    fun value(): U8
        """
        Represents the bit-shift value. Unshift by this value to get the flag.
        """

    fun hash(): USize => value().hash()

    fun eq(that: MessageFlag): Bool => value() == that.value()
primitive CrosspostedMessageFlag is MessageFlag
    """
    this message has been published to subscribed channels (via Channel Following)
    """

    fun value(): U8 => 0
primitive IsCrosspostMessageFlag is MessageFlag
    """
    this message originated from a message in another channel (via Channel Following)
    """

    fun value(): U8 => 1
primitive SuppressEmbedsMessageFlag is MessageFlag
    """
    do not include any embeds when serializing this message
    """

    fun value(): U8 => 2
primitive SourceMessageDeletedMessageFlag is MessageFlag
    """
    the source message for this crosspost has been deleted (via Channel Following)
    """

    fun value(): U8 => 3
primitive UrgentMessageFlag is MessageFlag
    """
    this message came from the urgent message system
    """

    fun value(): U8 => 4
primitive HasThreadMessageFlag is MessageFlag
    """
    this message has an associated thread, with the same id as the message
    """

    fun value(): U8 => 5
primitive EphemeralMessageFlag is MessageFlag
    """
    this message is only visible to the user who invoked the Interaction
    """

    fun value(): U8 => 6
primitive LoadingMessageFlag is MessageFlag
    """
    this message is an Interaction Response and the bot is "thinking"
    """

    fun value(): U8 => 7
primitive FailedToMentionSomeRolesInThreadMessageFlag is MessageFlag
    """
    this message failed to mention some roles and add their members to the thread
    """

    fun value(): U8 => 8
primitive SuppressNotificationsMessageFlag is MessageFlag
    """
    this message will not trigger push and desktop notifications
    """

    fun value(): U8 => 12
primitive IsVoiceMessageMessageFlag is MessageFlag
    """
    this message is a voice message
    """

    fun value(): U8 => 13
primitive HasSnapshotMessageFlag is MessageFlag
    """
    this message has a snapshot (via Message Forwarding)
    """

    fun value(): U8 => 14
primitive IsComponentsV2MessageFlag is MessageFlag
    """
    allows you to create fully component-driven messages

    Once a message has been sent with this flag, it can't be removed from that message.
    """

    fun value(): U8 => 15
primitive MessageFlags
    fun from(value: U8): MessageFlag ? =>
        match value
        | 0 => CrosspostedMessageFlag
        | 1 => IsCrosspostMessageFlag
        | 2 => SuppressEmbedsMessageFlag
        | 3 => SourceMessageDeletedMessageFlag
        | 4 => UrgentMessageFlag
        | 5 => HasThreadMessageFlag
        | 6 => EphemeralMessageFlag
        | 7 => LoadingMessageFlag
        | 8 => FailedToMentionSomeRolesInThreadMessageFlag
        | 12 => SuppressNotificationsMessageFlag
        | 13 => IsVoiceMessageMessageFlag
        | 14 => HasSnapshotMessageFlag
        | 15 => IsComponentsV2MessageFlag
        else error
        end

primitive _MessageFlags
    fun apply(bits: U64): Array[MessageFlag] val =>
        recover val
            let flags = Array[MessageFlag]
            var shift: U8 = 0
            while shift < 64 do
                if (bits and (U64(1) << shift.u64())) != 0 then
                    try flags.push(MessageFlags.from(shift)?) end
                end
                shift = shift + 1
            end
            flags
        end

    fun to_json(flags: Array[MessageFlag] val): I64 =>
        var bits: U64 = 0
        for flag in flags.values() do bits = bits or (U64(1) << flag.value().u64()) end
        bits.i64()

// https://docs.discord.com/developers/resources/message#message-interaction-metadata-object
//
// Metadata about the interaction, including the source of the interaction and relevant server and user IDs.
type MessageInteractionMetadata is (ApplicationCommandInteractionMetadata | MessageComponentInteractionMetadata | ModalSubmitInteractionMetadata)

primitive MessageInteractionMetadatas
    fun from_json(obj: json.JsonObject): MessageInteractionMetadata ? =>
        """
        Decodes message interaction metadata, dispatching on its `type` field.
        """

        match InteractionTypes.from((obj("type")? as I64).u8())?
        | ApplicationCommandInteractionType => ApplicationCommandInteractionMetadata.from_json(obj)?
        | MessageComponentInteractionType => MessageComponentInteractionMetadata.from_json(obj)?
        | ModalSubmitInteractionType => ModalSubmitInteractionMetadata.from_json(obj)?
        else error
        end

class val ApplicationCommandInteractionMetadata is Jsonable
    """
    https://docs.discord.com/developers/resources/message#message-interaction-metadata-object-application-command-interaction-metadata-structure
    """

    let id: Snowflake
        """
        ID of the interaction
        """

    let type': InteractionType
        """
        Type of interaction
        """

    let user: User
        """
        User who triggered the interaction
        """

    let authorizing_integration_owners: collections.Map[ApplicationIntegrationType, Snowflake] val
        """
        IDs for installation context(s) related to an interaction
        """

    let original_response_message_id: (Snowflake | None)
        """
        ID of the original response message, present only on follow-up messages
        """

    let target_user: (User | None)
        """
        The user the command was run on, present only on user command interactions
        """

    let target_message_id: (Snowflake | None)
        """
        The ID of the message the command was run on, present only on message command interactions. The original response message will also have `message_reference` and `referenced_message` pointing to this message.
        """

    new val create(
        id': Snowflake,
        type'': InteractionType,
        user': User,
        authorizing_integration_owners': collections.Map[ApplicationIntegrationType, Snowflake] val,
        original_response_message_id': (Snowflake | None) = None,
        target_user': (User | None) = None,
        target_message_id': (Snowflake | None) = None
    ) =>
        id = id'
        type' = type''
        user = user'
        authorizing_integration_owners = authorizing_integration_owners'
        original_response_message_id = original_response_message_id'
        target_user = target_user'
        target_message_id = target_message_id'

    new val from_json(obj: json.JsonObject) ? =>
        var id': (Snowflake | None) = None
        var type'': (InteractionType | None) = None
        var user': (User | None) = None
        var authorizing_integration_owners': (collections.Map[ApplicationIntegrationType, Snowflake] val | None) = None
        var original_response_message_id': (Snowflake | None) = None
        var target_user': (User | None) = None
        var target_message_id': (Snowflake | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "id" => id' = Snowflake.from_json(value)?
            | "type" => type'' = InteractionTypes.from((value as I64).u8())?
            | "user" => user' = User.from_json(value as json.JsonObject)?
            | "authorizing_integration_owners" => authorizing_integration_owners' = _AuthorizingIntegrationOwners(value)?
            | "original_response_message_id" => original_response_message_id' = Snowflake.from_json(value)?
            | "target_user" => target_user' = User.from_json(value as json.JsonObject)?
            | "target_message_id" => target_message_id' = Snowflake.from_json(value)?
            end
        end

        id = id' as Snowflake
        type' = type'' as InteractionType
        user = user' as User
        authorizing_integration_owners = authorizing_integration_owners' as collections.Map[ApplicationIntegrationType, Snowflake] val
        original_response_message_id = original_response_message_id'
        target_user = target_user'
        target_message_id = target_message_id'

    fun to_json(): json.JsonObject =>
        var obj = json.JsonObject
            .update("id", id.to_json())
            .update("type", type'.value().i64())
            .update("user", user.to_json())
            .update("authorizing_integration_owners", _AuthorizingIntegrationOwners.to_json(authorizing_integration_owners))

        match original_response_message_id
        | let original_response_message_id': Snowflake => obj = obj.update("original_response_message_id", original_response_message_id'.to_json())
        end

        match target_user
        | let target_user': User => obj = obj.update("target_user", target_user'.to_json())
        end

        match target_message_id
        | let target_message_id': Snowflake => obj = obj.update("target_message_id", target_message_id'.to_json())
        end

        obj

