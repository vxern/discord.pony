class val MessageAttachment is Jsonable
    """
    https://docs.discord.com/developers/resources/message#attachment-object-attachment-structure
    """

    let id: Snowflake
        """
        attachment id
        """

    let filename: String
        """
        name of file attached
        """

    let title: (String | None)
        """
        the title of the file
        """

    let description: (String | None)
        """
        description (alt text) for the file (max 1024 characters)
        """

    let content_type: (String | None)
        """
        the attachment's media type
        """

    let size: USize
        """
        size of file in bytes
        """

    let url: String
        """
        source url of file
        """

    let proxy_url: String
        """
        a proxied url of file
        """

    let height: (USize | None)
        """
        height of file (if image or video)
        """

    let width: (USize | None)
        """
        width of file (if image or video)
        """

    let placeholder: (String | None)
        """
        thumbhash placeholder (if image or video)
        """

    let placeholder_version: (USize | None)
        """
        version of the placeholder (if image or video)
        """

    let ephemeral: (Bool | None)
        """
        whether this attachment is ephemeral

        Ephemeral attachments will automatically be removed after a set period of time. Ephemeral attachments on messages are guaranteed to be available as long as the message itself exists.
        """

    let duration_secs: (F64 | None)
        """
        the duration of the audio or video file
        """

    let waveform: (String | None)
        """
        base64 encoded bytearray representing a sampled waveform (currently for voice messages)
        """

    let flags: (Array[MessageAttachmentFlag] val | None)
        """
        attachment flags combined as a bitfield
        """

    let clip_participants: (Array[User] val | None)
        """
        for Clips, array of users who were in the stream
        """

    let clip_created_at: (ISO8601 | None)
        """
        for Clips, when the clip was created
        """

    let application: (Application | None)
        """
        for Clips, the application in the stream, if recognized
        """

    new val create(
        id': Snowflake,
        filename': String,
        title': (String | None) = None,
        description': (String | None) = None,
        content_type': (String | None) = None,
        size': USize,
        url': String,
        proxy_url': String,
        height': (USize | None) = None,
        width': (USize | None) = None,
        placeholder': (String | None) = None,
        placeholder_version': (USize | None) = None,
        ephemeral': (Bool | None) = None,
        duration_secs': (F64 | None) = None,
        waveform': (String | None) = None,
        flags': (Array[MessageAttachmentFlag] val | None) = None,
        clip_participants': (Array[User] val | None) = None,
        clip_created_at': (ISO8601 | None) = None,
        application': (Application | None) = None
    ) =>
        id = id'
        filename = filename'
        title = title'
        description = description'
        content_type = content_type'
        size = size'
        url = url'
        proxy_url = proxy_url'
        height = height'
        width = width'
        placeholder = placeholder'
        placeholder_version = placeholder_version'
        ephemeral = ephemeral'
        duration_secs = duration_secs'
        waveform = waveform'
        flags = flags'
        clip_participants = clip_participants'
        clip_created_at = clip_created_at'
        application = application'

    new val from_json(obj: json.JsonObject) ? =>
        var id': (Snowflake | None) = None
        var filename': (String | None) = None
        var title': (String | None) = None
        var description': (String | None) = None
        var content_type': (String | None) = None
        var size': (USize | None) = None
        var url': (String | None) = None
        var proxy_url': (String | None) = None
        var height': (USize | None) = None
        var width': (USize | None) = None
        var placeholder': (String | None) = None
        var placeholder_version': (USize | None) = None
        var ephemeral': (Bool | None) = None
        var duration_secs': (F64 | None) = None
        var waveform': (String | None) = None
        var flags': (Array[MessageAttachmentFlag] val | None) = None
        var clip_participants': (Array[User] val | None) = None
        var clip_created_at': (ISO8601 | None) = None
        var application': (Application | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "id" => id' = Snowflake.from_json(value)?
            | "filename" => filename' = value as String
            | "title" => title' = value as String
            | "description" => description' = value as String
            | "content_type" => content_type' = value as String
            | "size" => size' = (value as I64).usize()
            | "url" => url' = value as String
            | "proxy_url" => proxy_url' = value as String
            | "height" =>
                match value | let integer: I64 => height' = integer.usize() end
            | "width" =>
                match value | let integer: I64 => width' = integer.usize() end
            | "placeholder" => placeholder' = value as String
            | "placeholder_version" => placeholder_version' = (value as I64).usize()
            | "ephemeral" => ephemeral' = value as Bool
            | "duration_secs" => duration_secs' = value as F64
            | "waveform" => waveform' = value as String
            | "flags" => flags' = _MessageAttachmentFlags((value as I64).u64())
            | "clip_participants" => clip_participants' = _Users(value)?
            | "clip_created_at" => clip_created_at' = value as String
            | "application" =>
                match value | let obj': json.JsonObject => application' = Application.from_json(obj')? end
            end
        end

        id = id' as Snowflake
        filename = filename' as String
        title = title'
        description = description'
        content_type = content_type'
        size = size' as USize
        url = url' as String
        proxy_url = proxy_url' as String
        height = height'
        width = width'
        placeholder = placeholder'
        placeholder_version = placeholder_version'
        ephemeral = ephemeral'
        duration_secs = duration_secs'
        waveform = waveform'
        flags = flags'
        clip_participants = clip_participants'
        clip_created_at = clip_created_at'
        application = application'

    fun to_json(): json.JsonObject =>
        var obj = json.JsonObject
            .update("id", id.to_json())
            .update("filename", filename)
            .update("size", size.i64())
            .update("url", url)
            .update("proxy_url", proxy_url)

        match title
        | let title': String => obj = obj.update("title", title')
        end

        match description
        | let description': String => obj = obj.update("description", description')
        end

        match content_type
        | let content_type': String => obj = obj.update("content_type", content_type')
        end

        match height
        | let height': USize => obj = obj.update("height", height'.i64())
        end

        match width
        | let width': USize => obj = obj.update("width", width'.i64())
        end

        match placeholder
        | let placeholder': String => obj = obj.update("placeholder", placeholder')
        end

        match placeholder_version
        | let placeholder_version': USize => obj = obj.update("placeholder_version", placeholder_version'.i64())
        end

        match ephemeral
        | let ephemeral': Bool => obj = obj.update("ephemeral", ephemeral')
        end

        match duration_secs
        | let duration_secs': F64 => obj = obj.update("duration_secs", duration_secs')
        end

        match waveform
        | let waveform': String => obj = obj.update("waveform", waveform')
        end

        match flags
        | let flags': Array[MessageAttachmentFlag] val => obj = obj.update("flags", _MessageAttachmentFlags.to_json(flags'))
        end

        match clip_participants
        | let clip_participants': Array[User] val => obj = obj.update("clip_participants", _Users.to_json(clip_participants'))
        end

        match clip_created_at
        | let clip_created_at': ISO8601 => obj = obj.update("clip_created_at", clip_created_at')
        end

        match application
        | let application': Application => obj = obj.update("application", application'.to_json())
        end

        obj

primitive _MessageAttachments
    fun apply(value: json.JsonValue): Array[MessageAttachment] val ? =>
        """
        Decodes an array of attachments.
        """

        let array = value as json.JsonArray
        recover val
            let attachments = Array[MessageAttachment](array.size())
            for attachment in array.values() do attachments.push(MessageAttachment.from_json(attachment as json.JsonObject)?) end
            attachments
        end

    fun to_json(attachments: Array[MessageAttachment] val): json.JsonArray =>
        var array = json.JsonArray
        for attachment in attachments.values() do array = array.push(attachment.to_json()) end
