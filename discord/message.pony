        let array = value as json.JsonArray
        recover val
            let pins = Array[MessagePin](array.size())
            for pin in array.values() do pins.push(MessagePin.from_json(pin as json.JsonObject)?) end
            pins
        end

    fun to_json(pins: Array[MessagePin] val): json.JsonArray =>
        var array = json.JsonArray
        for pin in pins.values() do array = array.push(pin.to_json()) end
        array

