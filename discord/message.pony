        for (key, value) in obj.pairs() do
            match key
            | "participants" => participants' = _Snowflakes(value)?
            | "ended_timestamp" =>
                match value | let string: String => ended_timestamp' = string end
            end
        end

        participants = participants' as Array[Snowflake] val
