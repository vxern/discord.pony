            | "original_response_message_id" => original_response_message_id' = Snowflake.from_json(value)?
            | "triggering_interaction_metadata" =>
                triggering_interaction_metadata' =
                    MessageInteractionMetadatas.from_json(value as json.JsonObject)? as
                        (ApplicationCommandInteractionMetadata | MessageComponentInteractionMetadata)
            end
