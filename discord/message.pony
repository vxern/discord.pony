class val MessageReference is Jsonable
    """
    https://docs.discord.com/developers/resources/message#message-reference-structure

    Message references are generic attribution on a message. There are multiple message types that have a `message_reference` object.
    """

    let type': (MessageReferenceType | None)
        """
        type of reference

        If unset, `DefaultMessageReferenceType` can be assumed in order to match the behavior before message reference had types. In future API versions this will become a required field.
        """

    let message_id: (Snowflake | None)
        """
        id of the originating message
        """

    let channel_id: (Snowflake | None)
        """
        id of the originating message's channel

        Optional when creating a reply, but always present when receiving an event/response that includes this data model. Required for forwards.
        """

    let guild_id: (Snowflake | None)
        """
        id of the originating message's guild
        """

    let fail_if_not_exists: (Bool | None)
        """
        when sending, whether to error if the referenced message doesn't exist instead of sending as a normal (non-reply) message, default true
        """

    new val create(
        type'': (MessageReferenceType | None) = None,
        message_id': (Snowflake | None) = None,
        channel_id': (Snowflake | None) = None,
        guild_id': (Snowflake | None) = None,
        fail_if_not_exists': (Bool | None) = None
    ) =>
        type' = type''
        message_id = message_id'
        channel_id = channel_id'
        guild_id = guild_id'
        fail_if_not_exists = fail_if_not_exists'

    new val from_json(obj: json.JsonObject) ? =>
        var type'': (MessageReferenceType | None) = None
        var message_id': (Snowflake | None) = None
        var channel_id': (Snowflake | None) = None
        var guild_id': (Snowflake | None) = None
        var fail_if_not_exists': (Bool | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "type" => type'' = MessageReferenceTypes.from((value as I64).u8())?
            | "message_id" => message_id' = Snowflake.from_json(value)?
            | "channel_id" => channel_id' = Snowflake.from_json(value)?
            | "guild_id" => guild_id' = Snowflake.from_json(value)?
            | "fail_if_not_exists" => fail_if_not_exists' = value as Bool
            end
        end

        type' = type''
        message_id = message_id'
        channel_id = channel_id'
        guild_id = guild_id'
        fail_if_not_exists = fail_if_not_exists'

    fun to_json(): json.JsonObject =>
        var obj = json.JsonObject

        match type'
        | let type''': MessageReferenceType => obj = obj.update("type", type'''.value().i64())
        end

        match message_id
        | let message_id': Snowflake => obj = obj.update("message_id", message_id'.to_json())
        end

        match channel_id
        | let channel_id': Snowflake => obj = obj.update("channel_id", channel_id'.to_json())
        end

        match guild_id
        | let guild_id': Snowflake => obj = obj.update("guild_id", guild_id'.to_json())
        end

        match fail_if_not_exists
        | let fail_if_not_exists': Bool => obj = obj.update("fail_if_not_exists", fail_if_not_exists')
        end

        obj

trait val MessageReferenceType is (collections.Hashable & Equatable[MessageReferenceType])
    """
    https://docs.discord.com/developers/resources/message#message-reference-types

    Determines how associated data is populated.
    """

    fun value(): U8

    fun coupled_message_field(): String
        """
        The field on the message that the reference populates.
        """

    fun hash(): USize => value().hash()

    fun eq(that: MessageReferenceType): Bool => value() == that.value()
primitive DefaultMessageReferenceType is MessageReferenceType
    """
    A standard reference used by replies.
    """

    fun value(): U8 => 0

    fun coupled_message_field(): String => "referenced_message"
primitive ForwardMessageReferenceType is MessageReferenceType
    """
    Reference used to point to a message at a point in time.

    `FORWARD` can only be used for basic messages; i.e. messages which do not have strong bindings to a non global entity. Thus Discord supports only messages with type `DEFAULT`, `REPLY`, `CHAT_INPUT_COMMAND`, or `CONTEXT_MENU_COMMAND`, and does not support messages with a poll, call, or activity. This is subject to change in the future.
    """

    fun value(): U8 => 1

    fun coupled_message_field(): String => "message_snapshot"
primitive MessageReferenceTypes
    fun from(value: U8): MessageReferenceType ? =>
        match value
        | 0 => DefaultMessageReferenceType
        | 1 => ForwardMessageReferenceType
        else error
        end

class val MessageSnapshot is Jsonable
    """
    https://docs.discord.com/developers/resources/message#message-snapshot-object-message-snapshot-structure

    A snapshot captures a minimal subset of a forwarded message, to prevent spoofing of forwarded data. Snapshots are immutable and taken at creation time.

    Discord documents the `message` field as a partial message object. Because that partial omits fields `Message` requires (`id`, `channel_id`, `author`, `tts`, `mention_everyone` and `pinned`), the documented subset is modelled here directly rather than as a nested `Message`.

    While message snapshots are able to support nested snapshots, Discord currently limits the depth of nesting to 1.
    """

    let type': MessageType
        """
        type of message
        """

    let content: String
        """
        contents of the message
        """

    let embeds: Array[MessageEmbed] val
        """
        any embedded content
        """

    let attachments: Array[MessageAttachment] val
        """
        any attached files that are not referenced in embeds or components
        """

    let timestamp: ISO8601
        """
        when this message was sent
        """

    let edited_timestamp: (ISO8601 | None)
        """
        when this message was edited (or null if never)
        """

    let flags: (Array[MessageFlag] val | None)
        """
        message flags combined as a bitfield
        """

    let mentions: Array[User] val
        """
        users specifically mentioned in the message
        """

    let mention_roles: Array[Snowflake] val
        """
        roles specifically mentioned in this message
        """

    let stickers: (Array[Sticker] val | None)
        """
        Deprecated. The stickers sent with the message
        """

    let sticker_items: (Array[StickerItem] val | None)
        """
        sent if the message contains stickers
        """

    let components: (Array[Component] val | None)
        """
        sent if the message contains components like buttons, action rows, or other interactive components
        """

    new val create(
        type'': MessageType,
        content': String,
        embeds': Array[MessageEmbed] val,
        attachments': Array[MessageAttachment] val,
        timestamp': ISO8601,
        edited_timestamp': (ISO8601 | None) = None,
        flags': (Array[MessageFlag] val | None) = None,
        mentions': Array[User] val,
        mention_roles': Array[Snowflake] val,
        stickers': (Array[Sticker] val | None) = None,
        sticker_items': (Array[StickerItem] val | None) = None,
        components': (Array[Component] val | None) = None
    ) =>
        type' = type''
        content = content'
        embeds = embeds'
        attachments = attachments'
        timestamp = timestamp'
        edited_timestamp = edited_timestamp'
        flags = flags'
        mentions = mentions'
        mention_roles = mention_roles'
        stickers = stickers'
        sticker_items = sticker_items'
        components = components'

    new val from_json(obj: json.JsonObject) ? =>
        let message = obj("message")? as json.JsonObject

        var type'': (MessageType | None) = None
        var content': (String | None) = None
        var embeds': (Array[MessageEmbed] val | None) = None
        var attachments': (Array[MessageAttachment] val | None) = None
        var timestamp': (ISO8601 | None) = None
        var edited_timestamp': (ISO8601 | None) = None
        var flags': (Array[MessageFlag] val | None) = None
        var mentions': (Array[User] val | None) = None
        var mention_roles': (Array[Snowflake] val | None) = None
        var stickers': (Array[Sticker] val | None) = None
        var sticker_items': (Array[StickerItem] val | None) = None
        var components': (Array[Component] val | None) = None

        for (key, value) in message.pairs() do
            match key
            | "type" => type'' = MessageTypes.from((value as I64).u8())?
            | "content" => content' = value as String
            | "embeds" => embeds' = _MessageEmbeds(value)?
            | "attachments" => attachments' = _MessageAttachments(value)?
            | "timestamp" => timestamp' = value as String
            | "edited_timestamp" =>
                match value | let string: String => edited_timestamp' = string end
            | "flags" => flags' = _MessageFlags((value as I64).u64())
            | "mentions" => mentions' = _Users(value)?
            | "mention_roles" => mention_roles' = _Snowflakes(value)?
            | "stickers" => stickers' = _Stickers(value)?
            | "sticker_items" => sticker_items' = _StickerItems(value)?
            | "components" => components' = _Components(value)?
            end
        end

        type' = type'' as MessageType
        content = content' as String
        embeds = embeds' as Array[MessageEmbed] val
        attachments = attachments' as Array[MessageAttachment] val
        timestamp = timestamp' as ISO8601
        edited_timestamp = edited_timestamp'
        flags = flags'
        mentions = mentions' as Array[User] val
        mention_roles = mention_roles' as Array[Snowflake] val
        stickers = stickers'
        sticker_items = sticker_items'
        components = components'

    fun to_json(): json.JsonObject =>
        var message = json.JsonObject
            .update("type", type'.value().i64())
            .update("content", content)
            .update("embeds", _MessageEmbeds.to_json(embeds))
            .update("attachments", _MessageAttachments.to_json(attachments))
            .update("timestamp", timestamp)
            .update("edited_timestamp", edited_timestamp)
            .update("mentions", _Users.to_json(mentions))
            .update("mention_roles", _Snowflakes.to_json(mention_roles))

        match flags
        | let flags': Array[MessageFlag] val => message = message.update("flags", _MessageFlags.to_json(flags'))
        end

        match stickers
        | let stickers': Array[Sticker] val => message = message.update("stickers", _Stickers.to_json(stickers'))
        end

        match sticker_items
        | let sticker_items': Array[StickerItem] val => message = message.update("sticker_items", _StickerItems.to_json(sticker_items'))
        end

        match components
        | let components': Array[Component] val => message = message.update("components", _Components.to_json(components'))
        end

        json.JsonObject.update("message", message)

primitive _MessageSnapshots
    fun apply(value: json.JsonValue): Array[MessageSnapshot] val ? =>
        """
        Decodes an array of message snapshots.
        """

        let array = value as json.JsonArray
        recover val
            let snapshots = Array[MessageSnapshot](array.size())
            for snapshot in array.values() do snapshots.push(MessageSnapshot.from_json(snapshot as json.JsonObject)?) end
            snapshots
        end

    fun to_json(snapshots: Array[MessageSnapshot] val): json.JsonArray =>
        var array = json.JsonArray
        for snapshot in snapshots.values() do array = array.push(snapshot.to_json()) end
        array

class val MessageReaction is Jsonable
    """
    https://docs.discord.com/developers/resources/message#reaction-object-reaction-structure
    """

    let count: USize
        """
        Total number of times this emoji has been used to react (including super reacts)
        """

    let count_details: MessageReactionCountDetails
        """
        Reaction count details object
        """

    let me: Bool
        """
        Whether the current user reacted using this emoji
        """

    let me_burst: Bool
        """
        Whether the current user super-reacted using this emoji
        """

    let emoji: Emoji
        """
        emoji information
        """

    let burst_colors: Array[String] val
        """
        HEX colors used for super reaction
        """

    new val create(
        count': USize,
        count_details': MessageReactionCountDetails,
        me': Bool,
        me_burst': Bool,
        emoji': Emoji,
        burst_colors': Array[String] val
    ) =>
        count = count'
        count_details = count_details'
        me = me'
        me_burst = me_burst'
        emoji = emoji'
        burst_colors = burst_colors'

    new val from_json(obj: json.JsonObject) ? =>
        var count': (USize | None) = None
        var count_details': (MessageReactionCountDetails | None) = None
        var me': (Bool | None) = None
        var me_burst': (Bool | None) = None
        var emoji': (Emoji | None) = None
        var burst_colors': (Array[String] val | None) = None

        for (key, value) in obj.pairs() do
            match key
            | "count" => count' = (value as I64).usize()
            | "count_details" => count_details' = MessageReactionCountDetails.from_json(value as json.JsonObject)?
            | "me" => me' = value as Bool
            | "me_burst" => me_burst' = value as Bool
            | "emoji" => emoji' = Emoji.from_json(value as json.JsonObject)?
            | "burst_colors" => burst_colors' = _Strings(value)?
            end
        end

        count = count' as USize
        count_details = count_details' as MessageReactionCountDetails
        me = me' as Bool
        me_burst = me_burst' as Bool
        emoji = emoji' as Emoji
        burst_colors = burst_colors' as Array[String] val

    fun to_json(): json.JsonObject =>
        json.JsonObject
            .update("count", count.i64())
            .update("count_details", count_details.to_json())
            .update("me", me)
            .update("me_burst", me_burst)
            .update("emoji", emoji.to_json())
            .update("burst_colors", _Strings.to_json(burst_colors))

primitive _MessageReactions
    fun apply(value: json.JsonValue): Array[MessageReaction] val ? =>
        """
        Decodes an array of reactions.
        """

        let array = value as json.JsonArray
        recover val
            let reactions = Array[MessageReaction](array.size())
            for reaction in array.values() do reactions.push(MessageReaction.from_json(reaction as json.JsonObject)?) end
            reactions
        end

    fun to_json(reactions: Array[MessageReaction] val): json.JsonArray =>
        var array = json.JsonArray
        for reaction in reactions.values() do array = array.push(reaction.to_json()) end
        array

class val MessageReactionCountDetails is Jsonable
    """
