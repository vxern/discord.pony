trait val MessageAttachmentFlag is (collections.Hashable & Equatable[MessageAttachmentFlag])
    """
    https://docs.discord.com/developers/resources/message#attachment-object-attachment-flags
    """

    fun value(): U8

    fun hash(): USize => value().hash()

    fun eq(that: MessageAttachmentFlag): Bool => value() == that.value()
primitive IsClipMessageAttachmentFlag is MessageAttachmentFlag
    """
    this attachment is a Clip from a stream
    """

    fun value(): U8 => 0
primitive IsThumbnailMessageAttachmentFlag is MessageAttachmentFlag
    """
    this attachment is the thumbnail of a thread in a media channel, displayed in the grid but not on the message
    """

    fun value(): U8 => 1
primitive IsRemixMessageAttachmentFlag is MessageAttachmentFlag
    """
    this attachment has been edited using the remix feature on mobile (deprecated)
    """

    fun value(): U8 => 2
primitive IsSpoilerMessageAttachmentFlag is MessageAttachmentFlag
    """
    this attachment was marked as a spoiler and is blurred until clicked
    """

    fun value(): U8 => 3
primitive IsAnimatedMessageAttachmentFlag is MessageAttachmentFlag
    """
    this attachment is an animated image
    """

    fun value(): U8 => 5
primitive MessageAttachmentFlags
    fun from(value: U8): MessageAttachmentFlag ? =>
        match value
        | 0 => IsClipMessageAttachmentFlag
        | 1 => IsThumbnailMessageAttachmentFlag
        | 2 => IsRemixMessageAttachmentFlag
        | 3 => IsSpoilerMessageAttachmentFlag
        | 5 => IsAnimatedMessageAttachmentFlag
        else error
        end

primitive _MessageAttachmentFlags
    fun apply(bits: U64): Array[MessageAttachmentFlag] val =>
        recover val
            let flags = Array[MessageAttachmentFlag]
            var shift: U8 = 0
            while shift < 64 do
                if (bits and (U64(1) << shift.u64())) != 0 then
                    try flags.push(MessageAttachmentFlags.from(shift)?) end
                end
                shift = shift + 1
            end
            flags
        end

    fun to_json(flags: Array[MessageAttachmentFlag] val): I64 =>
        var bits: U64 = 0
        for flag in flags.values() do bits = bits or (U64(1) << flag.value().u64()) end
        bits.i64()

